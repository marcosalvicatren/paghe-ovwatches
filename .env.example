# Copiare in .streamlit/secrets.toml (per Streamlit) oppure esportare come
# variabili d'ambiente per l'uso da riga di comando. NON committare il file
# reale con i valori compilati: solo questo .env.example va in Git.

# Necessari solo se si vuole sincronizzare le regole su GitHub invece di
# usare il fallback locale in config/rules_*.json.
GITHUB_TOKEN=
GITHUB_REPO=utente/nome-repo
GITHUB_BRANCH=main
